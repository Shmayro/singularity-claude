#!/usr/bin/env bash
# SessionStart hook for singularity-claude.
# Creates the data folder on first run, then reports skills that need attention. Prints nothing when all is fine:
# the skills themselves are listed by Claude Code like any other skill, so there is no need to inject them here.

set -euo pipefail

SINGULARITY_DATA="${HOME}/.claude/singularity"
mkdir -p "${SINGULARITY_DATA}/scores" "${SINGULARITY_DATA}/telemetry"

if [ ! -f "${SINGULARITY_DATA}/registry.json" ]; then
  printf '%s\n' '{"$schema": "singularity-registry-v1", "skills": {}}' > "${SINGULARITY_DATA}/registry.json"
fi
if [ ! -f "${SINGULARITY_DATA}/config.json" ]; then
  cat > "${SINGULARITY_DATA}/config.json" << 'CONFIG'
{
  "autoRepairThreshold": 50,
  "crystallizationThreshold": 90,
  "crystallizationMinExecutions": 5,
  "hardeningMinExecutions": 3,
  "telemetryEnabled": true,
  "scoringMode": "auto",
  "skillOutputDir": "~/.claude/skills",
  "gitTagPrefix": "singularity/"
}
CONFIG
fi

command -v jq &>/dev/null || exit 0

# Facts only, one line per skill. Thresholds come from config.json.
alerts=$(jq -r --slurpfile cfg "${SINGULARITY_DATA}/config.json" '
  ($cfg[0].autoRepairThreshold // 50) as $low
  | ($cfg[0].crystallizationThreshold // 90) as $high
  | ($cfg[0].crystallizationMinExecutions // 5) as $min
  | .skills | to_entries[] | .key as $k | .value as $v
  | if ($v.executionCount // 0) >= 2 and ($v.averageScore // 0) < $low then
      "- \($k): average score \($v.averageScore)/100 over \($v.executionCount) scored runs, below the repair threshold (\($low)). Repair: /singularity-claude:repair \($k)"
    elif ($v.executionCount // 0) >= $min and ($v.averageScore // 0) >= $high and $v.maturity == "hardened" then
      "- \($k): average score \($v.averageScore)/100 over \($v.executionCount) scored runs, ready to crystallize. Lock it: /singularity-claude:crystallize \($k)"
    else empty end
' "${SINGULARITY_DATA}/registry.json" 2>/dev/null || true)

[ -z "$alerts" ] && exit 0

context="singularity-claude skill alerts:
${alerts}"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  jq -n --arg c "$context" '{additional_context: $c}'
else
  jq -n --arg c "$context" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $c}}'
fi
